# Copy to .env.local for local play, and add the same values in Vercel > Settings > Environment Variables.

# Your Google Maps key: Maps JavaScript API + Street View Static API, restricted to your site's URLs.
MAPS_BROWSER_KEY=

# Optional separate server-only key. Leave empty to reuse the key above.
MAPS_SERVER_KEY=

# Your site's address. The server sends it so the website-restricted key works. Set it on Vercel.
SITE_URL=http://localhost:5200/

# Any long random string. Encrypts hunt tokens.
TOKEN_SECRET=

# Upstash Redis (free). Turns on the daily and monthly hunt limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional limits
DAILY_HUNTS_PER_IP=10
MONTHLY_HUNT_CAP=4500
